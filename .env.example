# Comma-separated API keys clients must send as "Authorization: Bearer <key>".
# Leave empty to disable auth (local development only).
API_KEYS=

# SearXNG instance with the JSON format enabled (docker-compose sets this for you).
SEARXNG_URL=http://localhost:8080

# include_answer uses Claude. Needs ANTHROPIC_API_KEY (or an `ant auth login` profile).
ANTHROPIC_API_KEY=
ANSWER_ENABLED=true
ANSWER_MODEL=claude-opus-5
ANSWER_EFFORT=low

# Fetching (used by advanced search, /extract, /crawl, /map)
FETCH_TIMEOUT=15
# Whole fetch, including redirects and the body, so a slow server cannot hold a slot forever.
FETCH_TOTAL_TIMEOUT=30
FETCH_CONCURRENCY=10
# Only enable when every caller is trusted: lets the server fetch internal addresses.
ALLOW_PRIVATE_NETWORKS=false
CRAWL_MAX_LIMIT=200

# MCP endpoint (/mcp): hostnames accepted besides localhost, comma-separated.
MCP_ALLOWED_HOSTS=
